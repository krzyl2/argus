# .NET build output
bin/
obj/
orchestrator/publish/

# Unignore add-on rootfs helper scripts that live under a 'bin' path
!argus/rootfs/usr/local/bin/
!argus/rootfs/usr/local/bin/**

# Python
__pycache__/
*.pyc
.venv/

# Generated proto stubs (never commit — generated from proto/argus.proto)
*_pb2.py
*_pb2_grpc.py
*_pb2.pyi
detector/argus_detector/proto/argus_pb2*.py

# mTLS certificates (private key material must never be committed)
deploy/certs/*.key
deploy/certs/*.crt
deploy/certs/*.srl

# Local dev secrets (never commit — use deploy/.env.example as the template)
deploy/.env
.env

# Dev compose mutable data (entities.yaml written by the UI, models, lock file)
deploy/dev-data/

# Node dependencies (SPA project)
orchestrator/ui/node_modules/
orchestrator/ui/*.tsbuildinfo

# Vite build output — generated into wwwroot/ at Docker build time (Phase 7 SPA migration).
# wwwroot/ used to hold hand-authored htmx.min.js/argus.css; those are superseded by
# orchestrator/ui/public/css/argus.css + the Vite build, which emptyOutDir wipes/regenerates.
orchestrator/Argus.Orchestrator/wwwroot/index.html
orchestrator/Argus.Orchestrator/wwwroot/assets/
orchestrator/Argus.Orchestrator/wwwroot/css/

# ── Local tooling ──
.mcp.json
.bg-shell/
.DS_Store
Thumbs.db
nul
nul.*
con
con.*
prn
prn.*
aux
aux.*
com[1-9]
com[1-9].*
lpt[1-9]
lpt[1-9].*
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace
.env.*
!.env.example
node_modules/
.next/
dist/
build/
venv/
target/
vendor/
*.log
coverage/
.cache/
tmp/
